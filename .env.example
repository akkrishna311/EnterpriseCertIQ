# ─────────────────────────────────────────────────────────────────
#  EnterpriseCertIQ  ·  Environment Configuration
#  Copy to .env.local and fill in values.
#  Never commit .env files — they are in .gitignore
# ─────────────────────────────────────────────────────────────────

# ── Backend toggle ────────────────────────────────────────────────
# "foundry_local"  → run models on your device (no Azure needed)
# "azure_foundry"  → run models via Azure AI Foundry project
MODEL_BACKEND=foundry_local

# ── Storage backend ───────────────────────────────────────────────
# "local"   → JSON files in ./backend/data/store/
# "cosmos"  → Azure Cosmos DB (requires COSMOS_* vars below)
STORAGE_BACKEND=local

# ────────────────────────────────────────────────────────────────
#  FOUNDRY LOCAL  (MODEL_BACKEND=foundry_local)
# ────────────────────────────────────────────────────────────────

# Foundry Local OpenAI-compatible endpoint (started by the SDK)
FOUNDRY_LOCAL_ENDPOINT=http://localhost:5273/v1

# Model alias to use — run `python3 scripts/setup_foundry.py --list` to see options
# Recommended options (check your device's catalog):
#   phi-4-mini                        (fast, reasoning-capable)
#   phi-4-mini-reasoning              (stronger reasoning, chat-only)
#   qwen2.5-coder-7b-instruct         (tool-calling support)
#   qwen2.5-0.5b                      (tiny, for smoke-testing)
FOUNDRY_LOCAL_MODEL_ALIAS=phi-4-mini

# Optional: separate model for the Readiness Critic (reasoning-heavy agent).
# Loaded into the same serving manager as the default model so /v1 can serve it.
# Note: Foundry Local reasoning builds are slow on laptops — for an interactive
# demo, leave this EMPTY (Critic runs on the fast phi-4-mini) and use a strong
# reasoning deployment on Azure instead (AZURE_AI_REASONING_DEPLOYMENT).
# To experiment locally: phi-4-mini-reasoning | phi-4-reasoning | deepseek-r1-7b.
# Reasoning models don't support tool-calling; the Critic runs tool-free on them.
FOUNDRY_LOCAL_REASONING_ALIAS=

# ────────────────────────────────────────────────────────────────
#  AZURE AI FOUNDRY  (MODEL_BACKEND=azure_foundry)
#  Fill in after local testing works.
# ────────────────────────────────────────────────────────────────

# Project endpoint — from AI Foundry portal:
#   Your project → Settings → Project details → Project endpoint
# Format: https://<hub-name>.api.azureml.ms
AZURE_AI_PROJECT_ENDPOINT=https://your-hub.api.azureml.ms

# API key — from AI Foundry portal:
#   Your project → Settings → API keys
# Leave empty if using managed identity (AZURE_USE_MANAGED_IDENTITY=true)
AZURE_AI_API_KEY=your-foundry-api-key-here

# API version for the inference endpoint
AZURE_AI_API_VERSION=2024-12-01-preview

# Model deployment name — from AI Foundry portal → Deployments
AZURE_AI_MODEL_DEPLOYMENT=gpt-4o

# Optional: separate deployment for reasoning agents (Critic, Retrospective)
# Leave same as AZURE_AI_MODEL_DEPLOYMENT to use one deployment for all
AZURE_AI_REASONING_DEPLOYMENT=gpt-4o

# Managed identity auth (set true when running in Azure with a managed identity)
# When true, AZURE_AI_API_KEY is ignored
AZURE_USE_MANAGED_IDENTITY=false

# ── Azure Cosmos DB ───────────────────────────────────────────────
# Required when STORAGE_BACKEND=cosmos
COSMOS_ENDPOINT=https://your-cosmos.documents.azure.com:443/
COSMOS_KEY=your-cosmos-key-here
COSMOS_DATABASE=enterprisecertiq

# ── Foundry IQ knowledge base ─────────────────────────────────────
# "local"  → keyword search over ./backend/data/documents/ (no Azure needed)
# Azure    → set to your AZURE_AI_PROJECT_ENDPOINT (Foundry IQ uses the same project)
FOUNDRY_IQ_ENDPOINT=local
FOUNDRY_IQ_INDEX_NAME=cert-knowledge-base

# ── Microsoft Learn MCP server ────────────────────────────────────
# Public, no auth required
MS_LEARN_MCP_URL=https://learn.microsoft.com/api/mcp

# ── Telemetry (OpenTelemetry) ─────────────────────────────────────
# false (default) = spans created but not exported — zero overhead locally
# true  + local   = console exporter (debug-level span dumps)
# true  + azure   = Azure Monitor exporter (requires connection string below)
ENABLE_TELEMETRY=false
# From Azure portal: Application Insights resource → Overview → Connection String
APPLICATIONINSIGHTS_CONNECTION_STRING=

# ── App settings ──────────────────────────────────────────────────
APP_NAME=EnterpriseCertIQ
LOG_LEVEL=INFO
BACKEND_PORT=8000
OWN_MCP_PORT=8001
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
